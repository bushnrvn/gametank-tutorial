+static void gt_script_tick() {
+	++gt_vframe;
+	gt_pix_sum += blitter->pixels_this_frame;
+	if(getenv("GT_FPS") && (gt_vframe % 120) == 0) { printf("vframe %ld flips/120=%ld blitpix/frame=%ld\n", gt_vframe, gt_total_flips - gt_last_flips, (long)(gt_pix_sum/120)); gt_pix_sum=0; gt_last_flips = gt_total_flips; }
+	while(gt_script_idx < gt_script.size() && gt_script[gt_script_idx].frame <= gt_vframe) {
+		GtScriptEv& ev = gt_script[gt_script_idx++];
+		if(ev.kind == 0) { joysticks->SetHeldButtons(ev.mask); }
+		else if(ev.kind == 1) { gt_pending_shot = ev.name; }
+		else if(ev.kind == 2) { gt_quit_req = true; }
+		else if(ev.kind == 4) { MemoryWrite((uint16_t)ev.mask, (uint8_t)atoi(ev.name.c_str())); }
+		else if(ev.kind == 3) {
+			int len = atoi(ev.name.c_str()); if(len <= 0) len = 1;
+			printf("PEEK f%ld %04X:", gt_vframe, ev.mask);
+			for(int k = 0; k < len; ++k) printf(" %d", MemoryRead((uint16_t)(ev.mask + k)));
+			printf("\n");
+		}
+	}
 }
 
