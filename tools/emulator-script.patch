+// ---- Dug Out test harness (local patch): scripted input + screenshots ----
+#include <fstream>
+#include <sstream>
+struct GtScriptEv { long frame; int kind; unsigned mask; std::string name; };
+static std::vector<GtScriptEv> gt_script;
+static size_t gt_script_idx = 0;
+static long gt_vframe = 0;
+static std::string gt_pending_shot;
+static bool gt_quit_req = false;
+static long gt_last_flips = 0;
+static unsigned gt_parse_mask(const std::string& t) {
+	unsigned m = 0; std::string cur; std::string tt = t + "+";
+	for(char c : tt) {
+		if(c == '+') {
+			if(cur == "UP") m |= 0b0000100000001000;
+			else if(cur == "DOWN") m |= 0b0000010000000100;
+			else if(cur == "LEFT") m |= 0b0000001000000000;
+			else if(cur == "RIGHT") m |= 0b0000000100000000;
+			else if(cur == "A") m |= 0b0000000000010000;
+			else if(cur == "B") m |= 0b0001000000000000;
+			else if(cur == "C") m |= 0b0010000000000000;
+			else if(cur == "START") m |= 0b0000000000100000;
+			cur.clear();
+		} else cur += c;
+	}
+	return m;
+}
+static void gt_script_init() {
+	if(getenv("GT_FAST")) gofast = true;
+	const char* f = getenv("GT_SCRIPT");
+	if(!f) return;
+	std::ifstream in(f); std::string line;
+	while(std::getline(in, line)) {
+		std::istringstream ls(line); std::string a, b, c; ls >> a >> b >> c;
+		if(a.empty() || a[0] == '#') continue;
+		GtScriptEv ev; ev.frame = atol(a.c_str()); ev.mask = 0;
+		if(b == "shot") { ev.kind = 1; ev.name = c; }
+		else if(b == "quit") { ev.kind = 2; }
+		else if(b == "poke") { ev.kind = 4; ev.mask = strtoul(c.c_str(), NULL, 16); std::string d2; ls >> d2; ev.name = d2; }
+		else if(b == "peek") { ev.kind = 3; ev.name = c; std::string d2; ls >> d2; ev.mask = strtoul(c.c_str(), NULL, 16); ev.frame = atol(a.c_str()); ev.name = d2; }
+		else { ev.kind = 0; ev.mask = gt_parse_mask(b); }
+		gt_script.push_back(ev);
+	}
+}
 bool paused = true;
 bool lshift = false;
 bool rshift = false;
